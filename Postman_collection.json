                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment request returned success', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "if (data.payment && data.payment.transaction_id) pm.collectionVariables.set('transaction_id', String(data.payment.transaction_id));"
                ]
