        {
          "name": "Make Payment - Failure Simulation (Limit or Gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment processed with expected decline or validation', function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "const data = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "    pm.expect(data.payment.final_status).to.eql('FAILED');",
                  "} else {",
                  "    pm.expect(data.detail || data.error).to.exist;",
                  "}"
                ]
              }
